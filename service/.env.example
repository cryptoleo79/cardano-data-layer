# cardano-data-layer — example environment.
# Copy to .env and fill what you have. The service runs with NONE of these set;
# routes whose source needs a key degrade to a clean 503 rather than failing.

# --- server ---
# PORT=8787
# HOST=127.0.0.1
# CDL_USER_AGENT=cardano-data-layer/0.1 (+https://github.com/cryptoleo79)

# --- sources (the four wired for the market slice) ---
# DexHunter: price / OHLCV. Keyless for /swap/averagePrice; X-Partner-Id only
# needed for swap-execution endpoints (out of scope — this is data, not trading).
# DEXHUNTER_PARTNER_ID=

# Koios: supply, holders, token registry, asset_info. Public tier needs NO key
# (5k req/day). Set a token for higher limits.
# KOIOS_TOKEN=

# Blockfrost: holders fallback + asset metadata/supply. Needs a free project_id
# from https://blockfrost.io (without it, holders fall back / return 503).
# BLOCKFROST_PROJECT_ID=

# OpenCNFT: NFT collection stats/sales. Many v2 endpoints work without a key but
# are rate-limited; set one if you have it.
# OPENCNFT_API_KEY=

# CIP-26 token registry: fully free, no key. (CIP26_BASE override only.)

# --- ohlcv poller ---
# Comma-separated token units to track (policyId+hexAssetName). Empty = the
# built-in seed set (MIN, SNEK, HOSKY). The history clock only runs for tracked units.
# CDL_POLL_UNITS=
# CDL_POLL_INTERVAL=300000   # daemon mode interval (ms); cron --once ignores this

# --- storage ---
# CDL_DB_PATH=./data/cdl.sqlite
